{
  "openapi": "3.0.1",
  "info": {
    "title": "黑马点评 hm-dianping",
    "description": "Apifox 联调接口文档，后端端口 8081，登录后请求头带 authorization",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    }
  ],
  "paths": {
    "/user/code": {
      "post": {
        "summary": "发送手机验证码",
        "operationId": "sendCode",
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "summary": "手机号验证码登录",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginFormDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK，data 为 token"
          }
        }
      }
    },
    "/user/logout": {
      "post": {
        "summary": "登出",
        "operationId": "logout",
        "security": [
          {
            "authHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/me": {
      "get": {
        "summary": "获取当前登录用户",
        "operationId": "me",
        "security": [
          {
            "authHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/info/{id}": {
      "get": {
        "summary": "查看用户详情",
        "operationId": "userInfo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/shop-type/list": {
      "get": {
        "summary": "查询商铺类型列表",
        "operationId": "queryTypeList",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/shop/{id}": {
      "get": {
        "summary": "查询商铺详情",
        "operationId": "queryShopById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/shop": {
      "post": {
        "summary": "新增商铺",
        "operationId": "saveShop",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Shop"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "更新商铺",
        "operationId": "updateShop",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Shop"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/shop/of/type": {
      "get": {
        "summary": "根据类型分页查询商铺",
        "operationId": "queryShopByType",
        "parameters": [
          {
            "name": "typeId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "current",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/shop/of/name": {
      "get": {
        "summary": "根据名称关键字分页查询商铺",
        "operationId": "queryShopByName",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "current",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/blog": {
      "post": {
        "summary": "发布探店笔记",
        "operationId": "saveBlog",
        "security": [
          {
            "authHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Blog"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/blog/like/{id}": {
      "put": {
        "summary": "点赞博客",
        "operationId": "likeBlog",
        "security": [
          {
            "authHeader": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/blog/of/me": {
      "get": {
        "summary": "查询我的博客",
        "operationId": "queryMyBlog",
        "security": [
          {
            "authHeader": []
          }
        ],
        "parameters": [
          {
            "name": "current",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/blog/hot": {
      "get": {
        "summary": "查询热门博客",
        "operationId": "queryHotBlog",
        "parameters": [
          {
            "name": "current",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/voucher": {
      "post": {
        "summary": "新增代金券",
        "operationId": "addVoucher",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Voucher"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/voucher/seckill": {
      "post": {
        "summary": "新增秒杀券",
        "operationId": "addSeckillVoucher",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Voucher"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/voucher/list/{shopId}": {
      "get": {
        "summary": "查询商铺的优惠券列表",
        "operationId": "queryVoucherOfShop",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/voucher-order/seckill/{id}": {
      "post": {
        "summary": "秒杀下单",
        "operationId": "seckillVoucher",
        "security": [
          {
            "authHeader": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/upload/blog": {
      "post": {
        "summary": "上传图片",
        "operationId": "uploadImage",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/upload/blog/delete": {
      "get": {
        "summary": "删除博客图片",
        "operationId": "deleteBlogImg",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "authHeader": {
        "type": "apiKey",
        "name": "authorization",
        "in": "header"
      }
    },
    "schemas": {
      "LoginFormDTO": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "手机号"
          },
          "code": {
            "type": "string",
            "description": "验证码"
          },
          "password": {
            "type": "string",
            "description": "密码（手机号密码登录时使用）"
          }
        }
      },
      "Shop": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string", "description": "商铺名称" },
          "typeId": { "type": "integer", "format": "int64", "description": "商铺类型id" },
          "images": { "type": "string", "description": "商铺图片，多个以,隔开" },
          "area": { "type": "string", "description": "商圈" },
          "address": { "type": "string" },
          "x": { "type": "number", "format": "double", "description": "经度" },
          "y": { "type": "number", "format": "double", "description": "纬度" },
          "avgPrice": { "type": "integer", "format": "int64", "description": "均价" },
          "sold": { "type": "integer", "description": "销量" },
          "comments": { "type": "integer", "description": "评论数" },
          "score": { "type": "integer", "description": "评分乘10" },
          "openHours": { "type": "string", "description": "营业时间" }
        }
      },
      "Voucher": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "shopId": { "type": "integer", "format": "int64" },
          "title": { "type": "string", "description": "标题" },
          "subTitle": { "type": "string", "description": "副标题" },
          "rules": { "type": "string", "description": "使用规则" },
          "payValue": { "type": "integer", "format": "int64", "description": "支付金额" },
          "actualValue": { "type": "integer", "format": "int64", "description": "抵扣金额" },
          "type": { "type": "integer", "description": "券类型" },
          "status": { "type": "integer", "description": "状态" },
          "stock": { "type": "integer", "description": "库存（秒杀券）" },
          "beginTime": { "type": "string", "format": "date-time", "description": "生效时间（秒杀券）" },
          "endTime": { "type": "string", "format": "date-time", "description": "失效时间（秒杀券）" }
        }
      },
      "Blog": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "shopId": { "type": "integer", "format": "int64", "description": "商户id" },
          "title": { "type": "string", "description": "标题" },
          "images": { "type": "string", "description": "探店照片，最多9张以,隔开" },
          "content": { "type": "string", "description": "描述文字" }
        }
      }
    }
  }
}
